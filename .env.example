# Daktari Mkononi environment.
#
# For LOCAL DEVELOPMENT you do not need this file: run `pnpm dev:setup`, which
# writes a .env with cryptographically generated secrets and every provider
# left blank (blank = local fake). This example documents the full contract for
# staging and production.
#
# There is ONE .env, at the repo root. The API server, the web app and the
# Prisma commands all load it explicitly by path.

# ── Always required ──────────────────────────────────────────────────────────
NODE_ENV=development
DATABASE_URL=postgresql://daktari:daktari@localhost:5432/daktari_dev

# Auth secrets (min 64 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# PHI encryption: EXACTLY 64 hex chars (32 bytes, AES-256-GCM). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this makes every previously encrypted row undecryptable.
ENCRYPTION_KEY=

# Server-side HMAC pepper for OTP hashing (min 32 chars).
OTP_PEPPER=
# HMAC secret for signed file-download tokens (min 32 chars).
FILE_SIGNING_SECRET=

# ── Dev defaults, REQUIRED in production ─────────────────────────────────────
# The schema defaults these to localhost; the production guard rejects a
# localhost value, because CORS, the refresh cookie and SMS links all use them.
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
# Where the browser reaches the API (inlined into the web bundle at build time).
NEXT_PUBLIC_API_URL=http://localhost:4000

# Unset in dev ⇒ in-memory rate limiting, /health/ready reports redis
# "skipped". Required in production, where a per-process limiter under-counts.
# REDIS_URL=redis://localhost:6379

# ── External providers ───────────────────────────────────────────────────────
# Blank ⇒ the local fake (see the table in README.md). The production guard
# refuses to boot on any blank below, so a fake can never reach real patients.

# AI screening. Blank ⇒ 503 AI_NOT_CONFIGURED. Deliberately NOT faked: a stub
# that answers medical triage plausibly is worse than one that is unavailable.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-6

# Mobile money — AzamPay (TZS only). Blank ⇒ FakePayments.
AZAMPAY_APP_NAME=
AZAMPAY_CLIENT_ID=
AZAMPAY_CLIENT_SECRET=
AZAMPAY_ENV=sandbox
AZAMPAY_WEBHOOK_SECRET=
# AZAMPAY_AUTH_BASE_URL=      # override the sandbox/production default
# AZAMPAY_CHECKOUT_BASE_URL=

# SMS gateway (OTPs, refund notices). Blank ⇒ ConsoleSms: codes print to the
# API console, which is how you sign in locally.
SMS_API_KEY=
SMS_USERNAME=sandbox
SMS_SENDER_ID=DAKTARI

# Video consultations — Daily.co. Blank ⇒ FakeVideo (stub rooms and tokens).
DAILY_CO_API_KEY=

# Document storage — S3. Blank ⇒ local disk under STORAGE_ROOT.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=af-south-1
STORAGE_ROOT=.storage

# ── Observability ────────────────────────────────────────────────────────────
# SENTRY_DSN=                 # validated if set; not yet wired to a reporter
LOG_LEVEL=info
