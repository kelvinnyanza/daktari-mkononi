# Daktari Mkononi environment.
#
# For LOCAL DEVELOPMENT you do not need this file: run `pnpm dev:setup`, which
# writes a .env with cryptographically generated secrets and every provider
# left blank (blank = local fake). This example documents the full contract for
# staging and production.
#
# There is ONE .env, at the repo root. The API server, the web app and the
# Prisma commands all load it explicitly by path.

# ── Always required ──────────────────────────────────────────────────────────
NODE_ENV=development
DATABASE_URL=postgresql://daktari:daktari@localhost:5432/daktari_dev

# Integration tests only — put this in `.env.test` (gitignored), NOT in .env.
# Read by `pnpm test:integration`; the database name must end in `_test`
# because the suite deletes every row it touches. Not a secret locally: the
# portable Postgres uses trust auth on localhost.
# TEST_DATABASE_URL=postgresql://daktari:daktari@localhost:5432/daktari_test

# Auth secrets (min 64 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# PHI encryption: EXACTLY 64 hex chars (32 bytes, AES-256-GCM). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this makes every previously encrypted row undecryptable.
ENCRYPTION_KEY=

# Server-side HMAC pepper for OTP hashing (min 32 chars).
OTP_PEPPER=
# HMAC secret for signed file-download tokens (min 32 chars).
FILE_SIGNING_SECRET=

# ── Dev defaults, REQUIRED in production ─────────────────────────────────────
# The schema defaults these to localhost; the production guard rejects a
# localhost value, because CORS, the refresh cookie and SMS links all use them.
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
# Where the browser reaches the API (inlined into the web bundle at build time).
NEXT_PUBLIC_API_URL=http://localhost:4000

# Unset in dev ⇒ in-memory rate limiting, /health/ready reports redis
# "skipped". Required in production, where a per-process limiter under-counts.
# REDIS_URL=redis://localhost:6379

# ── External providers ───────────────────────────────────────────────────────
# Blank ⇒ the local fake (see the table in README.md). The production guard
# refuses to boot on any blank below, so a fake can never reach real patients.

# AI screening. AI_PROVIDER = anthropic (default) | openai | fake.
# The SELECTED provider's key blank ⇒ 503 AI_NOT_CONFIGURED — never a silent
# fallback, because a stub that answers medical triage plausibly is worse than
# one that is unavailable. `fake` is an explicit dev-only choice (canned
# "[JARIBIO]" replies) and the production guard refuses it.
# Keep both keys set and AI_MODEL blank: switching is then AI_PROVIDER alone.
# AI_MODEL blank ⇒ provider default (claude-sonnet-4-6 / gpt-6.1-sol); a model
# id from the other provider is rejected at startup.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_MODEL=

# Mobile money — AzamPay (TZS only). Blank ⇒ FakePayments.
AZAMPAY_APP_NAME=
AZAMPAY_CLIENT_ID=
AZAMPAY_CLIENT_SECRET=
AZAMPAY_ENV=sandbox
# AZAMPAY_AUTH_BASE_URL=           # override the sandbox/production default
# AZAMPAY_CHECKOUT_BASE_URL=
# AZAMPAY_DISBURSEMENT_BASE_URL=
# Authenticator for the disbursement host, if AzamPay issues those tokens
# separately (sandbox api-disbursement-test rejects authenticator-sandbox tokens).
# AZAMPAY_DISBURSEMENT_AUTH_BASE_URL=
# AzamPay documents no checkout status API: on = ask the disbursement one
# anyway (harmless), off = signed callbacks + statement reconciliation only.
AZAMPAY_CHECKOUT_STATUS_QUERY=on
# RSA public key AzamPay issues (PEM, may be one line with literal \n) — NOT
# the UUID API key from the portal. Encrypts disbursement checksums AND
# verifies callback signatures. Required in production. Blank in dev ⇒
# callbacks count as unsigned, payouts/refunds go without a checksum.
AZAMPAY_CHECKSUM_PUBLIC_KEY=
# Only if AzamPay signs callbacks with a different key than the checksum one.
# AZAMPAY_CALLBACK_PUBLIC_KEY=
AZAMPAY_DISBURSE_SOURCE_ACCOUNT=
AZAMPAY_DISBURSE_SOURCE_NAME=
AZAMPAY_DISBURSE_SOURCE_BANK=
# Minutes after the 30-minute payment window in which a late payment still
# confirms the booking (if the slot is still free). 0 = refund every late one.
PAYMENT_GRACE_MINUTES=5
# pnpm azampay:sandbox-test — sandbox wallets (+255…) to charge / pay out to.
AZAMPAY_SANDBOX_TEST_MSISDN=
AZAMPAY_SANDBOX_TEST_DISBURSE_MSISDN=

# SMS gateway (OTPs, refund notices). Blank ⇒ ConsoleSms: codes print to the
# API console, which is how you sign in locally.
SMS_API_KEY=
SMS_USERNAME=sandbox
SMS_SENDER_ID=DAKTARI

# Video consultations — Daily.co. Blank ⇒ FakeVideo (stub rooms and tokens).
DAILY_CO_API_KEY=
# Doctors may start a consultation this many minutes before the slot.
CONSULTATION_START_EARLY_MINUTES=15

# Document storage — S3 (af-south-1). S3_BUCKET blank ⇒ local disk under
# STORAGE_ROOT. Required in production. Server-side encryption is always on:
# SSE-KMS with S3_KMS_KEY_ID, else SSE-S3. Keys blank ⇒ instance/task role.
S3_BUCKET=
# S3_KMS_KEY_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=af-south-1
STORAGE_ROOT=.storage

# ── Observability ────────────────────────────────────────────────────────────
# SENTRY_DSN=                 # validated if set; not yet wired to a reporter
LOG_LEVEL=info
