// Daktari Mkononi — domain model (Phase 1)
// All money fields are integer TZS (no cents).
// Soft deletes (deletedAt) on User, Patient, MedicalRecord, Prescription —
// repositories must filter deletedAt: null by default.
// MedicalRecord.encryptedContent holds AES-256-GCM ciphertext (iv:tag:data, base64).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  PATIENT
  DOCTOR
  HOSPITAL_ADMIN
  PHARMACY_STAFF
  PLATFORM_ADMIN
  SUPER_ADMIN
}

enum Language {
  SW
  EN
}

enum Gender {
  MALE
  FEMALE
  UNDISCLOSED // "Sipendi kusema" — answered, prefers not to say (null = not answered yet)
}

enum BloodType {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
}

enum OtpPurpose {
  PHONE_VERIFY
  LOGIN
  PASSWORD_RESET
  PHONE_CHANGE
}

enum DoctorVerificationStatus {
  PENDING
  DOCUMENTS_SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum DoctorDocumentType {
  TMC_CERTIFICATE
  MEDICAL_DEGREE
  PRACTICE_LICENSE
  NATIONAL_ID
  POLICE_CLEARANCE
  PROFILE_PHOTO
  OTHER
}

enum DocumentReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TriageLevel {
  SELF_CARE
  TELECONSULTATION
  IN_PERSON_VISIT
  EMERGENCY
}

enum ScreeningSessionStatus {
  ACTIVE
  COMPLETED
  EXPIRED
  ABANDONED
}

enum AppointmentType {
  VIDEO
  AUDIO
  CHAT
  IN_PERSON
}

enum AppointmentStatus {
  PENDING_PAYMENT
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

// How the patient intends to settle the appointment (Payment rows land in Phase 7).
enum PaymentIntentType {
  MOBILE_MONEY
  NHIF
  INSURANCE
  CASH_AT_FACILITY
}

enum ConsultationStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum DiagnosisType {
  PRIMARY
  SECONDARY
  DIFFERENTIAL
}

enum MedicalRecordType {
  CONSULTATION_NOTE
  LAB_RESULT
  IMAGING
  VACCINATION
  DISCHARGE_SUMMARY
  OTHER
}

enum PrescriptionStatus {
  ACTIVE
  PARTIALLY_DISPENSED
  DISPENSED
  EXPIRED
  CANCELLED
}

enum PaymentMethod {
  MPESA
  TIGO_PESA
  AIRTEL_MONEY
  HALOPESA
  NHIF
  INSURANCE
  CASH
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

// Why a payment needs an admin's eyes (Phase 13a). Set together with an
// audit entry; cleared by an admin resolving it (reviewResolvedAt).
enum PaymentReviewReason {
  LATE_SUCCESS // money arrived for an appointment that was no longer payable → auto-refund
  AMOUNT_MISMATCH // provider amount unreadable → never confirmed, an admin decides
  UNDERPAID // received < owed → not confirmed, full refund of what was received
  OVERPAID // received > owed → confirmed, the difference refunded
  STUCK_PROCESSING // abandoned payment still not final after 24h of status checks
  STRAY_ATTEMPT // a superseded attempt reported success → money held outside the current attempt
  STATUS_CONFLICT // signed callback and status query disagree → nothing applied until an admin checks
}

enum RefundState {
  PROCESSING // refund requested from the provider, outcome not yet final
  COMPLETED
  FAILED // provider refused / unsupported → admin retries or completes manually
}

// What the refund in flight pays back.
enum RefundKind {
  FULL // everything still held (received − already-refunded excess) → payment REFUNDED
  EXCESS // only an overpayment's difference → payment stays COMPLETED, earning untouched
}

enum VatMode {
  ON_TOP_OF_COMMISSION // VAT added on top of the commission; doctor's share = fee − commission − VAT
  INCLUDED_IN_COMMISSION // the commission already contains the VAT: it comes out of the PLATFORM's commission; doctor's share = fee − commission
}

enum DoctorPaymentStatus {
  PENDING // owed, not yet in an approved payout
  PROCESSING // in an approved payout, disbursement in flight
  PAID
  FAILED // payout failed (reason on the row); retried via the payout item
  REVERSED // refunded before payout — never paid (Phase 13a)
}

enum DoctorPaymentKind {
  EARNING // doctor share of a completed consultation
  ADJUSTMENT // negative correction (refund after payout) netted in the next payout
}

enum PayoutAccountType {
  MOBILE_MONEY
  BANK
}

enum PayoutOperator {
  MPESA
  TIGO_PESA
  AIRTEL_MONEY
  HALOPESA
  AZAMPESA
}

enum PayoutAccountStatus {
  NAME_PENDING_CONFIRMATION // AzamPay returned a name; the doctor must confirm it
  LOOKUP_FAILED // AzamPay could not confirm the holder → an admin verifies manually
  VERIFIED // doctor confirmed the looked-up name (or an admin verified)
}

enum PayoutBatchStatus {
  DRAFT // earnings reserved, nothing sent
  PROCESSING // approved; disbursements in flight / some failed
  COMPLETED // every item PAID
  CANCELLED // draft discarded, earnings released
}

enum PayoutItemStatus {
  PENDING // in a draft
  PROCESSING // disbursement sent (or outcome unknown) — never resent blind
  PAID
  FAILED // definitive failure / unsupported destination → retry or pay manually
}

enum DeliveryStatus {
  PENDING
  PHARMACY_ACCEPTED
  DISPATCHED
  IN_TRANSIT
  DELIVERED
  FAILED
  CANCELLED
}

enum NotificationChannel {
  SMS
  WHATSAPP
  PUSH
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
}

enum ChronicConditionType {
  DIABETES
  HYPERTENSION
  HIV_AIDS
  ASTHMA
  SICKLE_CELL
  TUBERCULOSIS
  OTHER
}

// ─── Identity & auth ─────────────────────────────────────────────────────────

model User {
  id              String    @id @default(cuid())
  phone           String    @unique // normalized +255XXXXXXXXX
  email           String?   @unique
  passwordHash    String
  fullName        String
  role            UserRole
  language        Language  @default(SW)
  isActive        Boolean   @default(true)
  phoneVerifiedAt DateTime?
  failedLoginCount Int      @default(0)
  lockedUntil      DateTime?
  twoFactorEnabled Boolean  @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime? // soft delete

  sessions      Session[]
  otpCodes      OtpCode[]
  patient       Patient?
  doctor        Doctor?
  hospitalAdmin HospitalAdmin?
  notifications Notification[]
  auditLogs     AuditLog[]     @relation("AuditActor")

  @@index([role])
  @@index([deletedAt])
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique
  tokenFamily      String    @unique // one rotation family per session (reuse detection)
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  revokedReason    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

model OtpCode {
  id         String     @id @default(cuid())
  userId     String?
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  phone      String // OTPs can precede account creation
  codeHash   String
  purpose    OtpPurpose
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([phone, purpose])
  @@index([expiresAt])
}

// ─── Patients ────────────────────────────────────────────────────────────────

model Patient {
  id                           String     @id @default(cuid())
  userId                       String     @unique
  user                         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  patientNumber                String     @unique @default(cuid()) // platform-assigned, never patient-editable
  // Collected in the health profile (UI Phase 2), not at registration: null
  // until the patient saves it. 18+ enforced by @daktari/schemas.
  dateOfBirth                  DateTime?
  gender                       Gender?
  // LEGACY plaintext health columns (bloodType … currentMedications): no
  // longer written — the health profile lives in encryptedHealthProfile.
  // Readers fall back to them only while a row has no blob; the backfill
  // (api-server `health:encrypt-backfill`) moves them and clears them.
  bloodType                    BloodType?
  region                       String
  district                     String
  ward                         String?
  street                       String?
  address                      String?
  heightCm                     Float?
  weightKg                     Float?
  allergies                    String[]   @default([])
  chronicConditions            String[]   @default([])
  currentMedications           String[]   @default([])
  nhifCardNumber               String?
  nhifVerifiedAt               DateTime? // set by admin verification, never patient-editable
  emergencyContactName         String?
  emergencyContactPhone        String?
  emergencyContactRelationship String?
  // Health profile (height, weight, BP history, blood group, allergies,
  // chronic conditions, medications) as ONE encryptHealthData v1 blob.
  encryptedHealthProfile       String?
  healthProfileUpdatedAt       DateTime?
  // PDPA: explicit consent to store health information, with the wording version.
  healthConsentAt              DateTime?
  healthConsentVersion         String?
  createdAt                    DateTime   @default(now())
  updatedAt                    DateTime   @updatedAt
  deletedAt                    DateTime? // soft delete

  appointments     Appointment[]
  consultations    Consultation[]
  screeningResults AIScreeningResult[]
  vitalSigns       VitalSign[]
  medicalRecords   MedicalRecord[]
  prescriptions    Prescription[]
  chronicTrackings ChronicTracking[]
  payments         Payment[]
  deliveries       MedicineDelivery[]
  ratings          ConsultationRating[]
  insurances       PatientInsurance[]

  @@index([region])
  @@index([deletedAt])
}

model PatientInsurance {
  id           String    @id @default(cuid())
  patientId    String
  patient      Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  provider     String // e.g. NHIF, Jubilee, Strategis
  memberNumber String
  validUntil   DateTime?
  isPrimary    Boolean   @default(false)
  verifiedAt   DateTime? // set once the insurer confirms membership
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([patientId, provider, memberNumber])
}

// ─── Doctors ─────────────────────────────────────────────────────────────────

model Doctor {
  id                    String                   @id @default(cuid())
  userId                String                   @unique
  user                  User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tmcRegistrationNumber String                   @unique
  specialty             String
  subSpecialty          String?
  yearsOfExperience     Int
  consultationFeeTzs    Int
  // Admin-set commission override in basis points (2000 = 20%); null ⇒ the
  // platform FeeSettings rate. Changes are audited (FEE_OVERRIDE_CHANGED).
  commissionOverrideBps Int?
  bio                   String?
  languages             String[]                 @default(["sw"])
  verificationStatus    DoctorVerificationStatus @default(PENDING)
  verifiedAt            DateTime?
  verifiedByUserId      String? // PLATFORM_ADMIN who approved
  claimedByUserId       String? // reviewer who moved it to UNDER_REVIEW
  rejectionReason       String?
  suspensionReason      String?
  region                String? // practice location, used by the public directory filters
  acceptsNhif           Boolean                  @default(false)
  hospitalId            String?
  hospital              Hospital?                @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  isAvailable           Boolean                  @default(false)
  averageRating         Float                    @default(0)
  totalRatings          Int                      @default(0)
  totalConsultations    Int                      @default(0)
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  documents      DoctorDocument[]
  schedules      DoctorSchedule[]
  appointments   Appointment[]
  consultations  Consultation[]
  prescriptions  Prescription[]
  doctorPayments DoctorPayment[]
  payoutAccount  DoctorPayoutAccount?
  payoutItems    PayoutItem[]
  ratings        ConsultationRating[]

  @@index([specialty, verificationStatus])
  @@index([hospitalId])
}

model DoctorDocument {
  id               String               @id @default(cuid())
  doctorId         String
  doctor           Doctor               @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  type             DoctorDocumentType
  fileKey          String // storage object key
  fileName         String
  mimeType         String
  reviewStatus     DocumentReviewStatus @default(PENDING)
  reviewedByUserId String?
  uploadedAt       DateTime             @default(now())
  reviewedAt       DateTime?
  reviewNotes      String?

  // Re-uploading a document type replaces the previous one (review resets).
  @@unique([doctorId, type])
  @@index([doctorId])
}

model DoctorSchedule {
  id                  String   @id @default(cuid())
  doctorId            String
  doctor              Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  dayOfWeek           Int // 0 = Sunday … 6 = Saturday
  startTime           String // HH:mm (24h, Africa/Dar_es_Salaam)
  endTime             String // HH:mm
  breaks              Json     @default("[]") // [{ startTime: HH:mm, endTime: HH:mm }] within the window
  slotDurationMinutes Int      @default(30)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([doctorId, dayOfWeek, startTime])
}

// ─── Hospitals ───────────────────────────────────────────────────────────────

model Hospital {
  id        String   @id @default(cuid())
  name      String
  region    String
  district  String
  address   String
  phone     String
  email     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  departments HospitalDepartment[]
  admins      HospitalAdmin[]
  doctors     Doctor[]

  @@index([region])
}

model HospitalDepartment {
  id         String   @id @default(cuid())
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  name       String
  nameSw     String? // Swahili display name
  createdAt  DateTime @default(now())

  @@unique([hospitalId, name])
}

model HospitalAdmin {
  id         String   @id @default(cuid())
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String?
  createdAt  DateTime @default(now())

  @@index([hospitalId])
}

// ─── AI screening / triage ───────────────────────────────────────────────────

// Doubles as the screening SESSION row (Phase 6): status/turns/tokens track
// the conversation; the transcript is PHI and lives in ONE encrypted blob.
model AIScreeningResult {
  id                    String      @id @default(cuid())
  patientId             String
  patient               Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  sessionId             String      @unique // uuid of the chat session
  language              Language    @default(SW)
  status                ScreeningSessionStatus @default(ACTIVE)
  turnCount             Int         @default(0) // patient messages processed (cap 12)
  tokensUsed            Int         @default(0) // cumulative model tokens (budget 8000)
  lastActivityAt        DateTime    @default(now()) // sessions expire 30 min after this
  symptomsSummary       String?
  encryptedConversation String? // AES-256-GCM v1 payload — full transcript, never plaintext
  triageLevel           TriageLevel?
  urgencyScore          Int? // 0–10 from the structured triage check
  recommendedSpecialty  String?
  confidence            Float?
  escalatedToEmergency  Boolean     @default(false) // guidance shown: 112 / 115
  createdAt             DateTime    @default(now())

  appointments Appointment[]

  @@index([patientId, createdAt])
  @@index([triageLevel])
  @@index([status, lastActivityAt])
}

// ─── Appointments & consultations ────────────────────────────────────────────

model Appointment {
  id                 String             @id @default(cuid())
  patientId          String
  patient            Patient            @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctorId           String
  doctor             Doctor             @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  type               AppointmentType
  status             AppointmentStatus  @default(PENDING_PAYMENT)
  scheduledAt        DateTime // UTC; slots are computed in Africa/Dar_es_Salaam (EAT, UTC+3)
  durationMinutes    Int                @default(30)
  reason             String
  paymentIntent      PaymentIntentType
  pendingReason      String? // e.g. INSURANCE_UNVERIFIED while stuck in PENDING_PAYMENT
  expiresAt          DateTime? // unpaid MOBILE_MONEY bookings auto-cancel after this
  checkInToken       String?            @unique // minted on confirmation for IN_PERSON
  confirmedAt        DateTime?
  checkedInAt        DateTime?
  technicalFailureAt DateTime? // set on the once-only IN_PROGRESS → CONFIRMED restart
  screeningResultId  String?
  screeningResult    AIScreeningResult? @relation(fields: [screeningResultId], references: [id], onDelete: SetNull)
  cancellationReason String?
  cancelledByUserId  String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  consultation Consultation?
  payment      Payment?

  // NOTE: slot exclusivity is enforced by a partial unique index
  //   uniq_appointment_active_slot ON (doctorId, scheduledAt)
  //   WHERE status NOT IN ('CANCELLED', 'NO_SHOW')
  // Prisma cannot express partial indexes — packages/db exports
  // ensureBookingSlotIndex() which creates it; run after `prisma db push`.
  @@index([doctorId, scheduledAt])
  @@index([patientId, scheduledAt])
  @@index([status])
  @@index([status, expiresAt])
}

model Consultation {
  id                 String             @id @default(cuid())
  appointmentId      String             @unique
  appointment        Appointment        @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  patientId          String
  patient            Patient            @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctorId           String
  doctor             Doctor             @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  status             ConsultationStatus @default(IN_PROGRESS)
  startedAt          DateTime           @default(now())
  endedAt            DateTime?
  durationSeconds    Int?
  endReason          String? // COMPLETED | TECHNICAL_FAILURE:<detail> | …
  // ALL free-text clinical fields (chief complaint, HPI, examination,
  // assessment, plan) live in ONE AES-256-GCM blob — never plaintext columns.
  encryptedNotes     String?
  videoRoomId        String?
  videoRoomUrl       String?
  recordingConsentGiven Boolean         @default(false) // set only by the patient, audited
  recordingConsentAt DateTime?
  followUpRequired   Boolean            @default(false)
  followUpDate       DateTime?
  referredToInPerson Boolean            @default(false)
  referralNotes      String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  diagnoses      Diagnosis[]
  prescriptions  Prescription[]
  medicalRecords MedicalRecord[]
  messages       ConsultationMessage[]
  rating         ConsultationRating?

  @@index([doctorId, startedAt])
  @@index([patientId, startedAt])
}

// Chat transcript for CHAT consultations. Bodies are PHI → encrypted at rest.
model ConsultationMessage {
  id             String       @id @default(cuid())
  consultationId String
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  senderUserId   String
  encryptedBody  String // AES-256-GCM v1 payload (max 2000 chars plaintext)
  sentAt         DateTime     @default(now())

  @@index([consultationId, sentAt])
}

model Diagnosis {
  id             String       @id @default(cuid())
  consultationId String
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  icd10Code      String // e.g. B50.9
  description    String
  type           DiagnosisType @default(SECONDARY) // max one PRIMARY per consultation
  createdAt      DateTime     @default(now())

  @@index([consultationId])
  @@index([icd10Code])
}

model ConsultationRating {
  id             String       @id @default(cuid())
  consultationId String       @unique
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  patientId      String
  patient        Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId       String
  doctor         Doctor       @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  rating         Int // 1–5 overall
  communication  Int? // optional 1–5 dimensions
  professionalism Int?
  timeliness     Int?
  comment        String? // sanitized upstream
  createdAt      DateTime     @default(now())

  @@index([doctorId])
}

// ─── Medical records (PHI — encrypted at rest) ───────────────────────────────

model MedicalRecord {
  id               String            @id @default(cuid())
  patientId        String
  patient          Patient           @relation(fields: [patientId], references: [id], onDelete: Restrict)
  consultationId   String?
  consultation     Consultation?     @relation(fields: [consultationId], references: [id], onDelete: SetNull)
  type             MedicalRecordType
  title            String
  summary          String? // short, deliberately non-sensitive
  encryptedContent String // AES-256-GCM v1 payload (@daktari/encryption)
  createdByUserId  String
  // Records are immutable; corrections are NEW records referencing the original.
  addendumToId     String?
  addendumTo       MedicalRecord?    @relation("RecordAddenda", fields: [addendumToId], references: [id], onDelete: SetNull)
  addenda          MedicalRecord[]   @relation("RecordAddenda")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime? // soft delete

  @@index([patientId, createdAt])
  @@index([deletedAt])
}

// ─── Prescriptions & pharmacy ────────────────────────────────────────────────

model Prescription {
  id             String             @id @default(cuid())
  consultationId String
  consultation   Consultation       @relation(fields: [consultationId], references: [id], onDelete: Restrict)
  patientId      String
  patient        Patient            @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctorId       String
  doctor         Doctor             @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  status         PrescriptionStatus @default(ACTIVE)
  validityDays   Int                @default(30)
  issuedAt       DateTime           @default(now())
  expiresAt      DateTime
  notes          String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  deletedAt      DateTime? // soft delete

  medications PrescriptionMedication[]
  delivery    MedicineDelivery?

  @@index([patientId, issuedAt])
  @@index([status])
  @@index([deletedAt])
}

model PrescriptionMedication {
  id             String       @id @default(cuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  name           String
  dosage         String // e.g. "500 mg"
  frequency      String // e.g. "mara 3 kwa siku"
  durationDays   Int
  quantity       Int
  instructions   String?
  dispensedAt    DateTime?

  @@index([prescriptionId])
}

model MedicineDelivery {
  id              String         @id @default(cuid())
  prescriptionId  String         @unique
  prescription    Prescription   @relation(fields: [prescriptionId], references: [id], onDelete: Restrict)
  patientId       String
  patient         Patient        @relation(fields: [patientId], references: [id], onDelete: Restrict)
  status          DeliveryStatus @default(PENDING)
  pharmacyName    String?
  deliveryAddress String
  region          String
  district        String
  phone           String // +255XXXXXXXXX contact for the courier
  feeTzs          Int
  courierName     String?
  trackingNotes   String?
  dispatchedAt    DateTime?
  deliveredAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  payment Payment?

  @@index([patientId])
  @@index([status])
}

// ─── Vitals & chronic care ───────────────────────────────────────────────────

model VitalSign {
  id               String   @id @default(cuid())
  patientId        String
  patient          Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  recordedByUserId String? // self-recorded when null
  systolicBp       Int? // mmHg
  diastolicBp      Int? // mmHg
  heartRate        Int? // bpm
  temperatureC     Float? // °C
  respiratoryRate  Int? // breaths/min
  oxygenSaturation Int? // SpO2 %
  bloodGlucoseMmol Float? // mmol/L
  weightKg         Float?
  heightCm         Float?
  notes            String?
  recordedAt       DateTime @default(now())
  createdAt        DateTime @default(now())

  @@index([patientId, recordedAt])
}

model ChronicTracking {
  id              String               @id @default(cuid())
  patientId       String
  patient         Patient              @relation(fields: [patientId], references: [id], onDelete: Cascade)
  condition       ChronicConditionType
  diagnosedAt     DateTime?
  notes           String?
  isActive        Boolean              @default(true)
  nextCheckupDate DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([patientId])
}

// ─── Payments (TZS only) ─────────────────────────────────────────────────────

model Payment {
  id                      String            @id @default(cuid())
  patientId               String
  patient                 Patient           @relation(fields: [patientId], references: [id], onDelete: Restrict)
  appointmentId           String?           @unique
  appointment             Appointment?      @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  deliveryId              String?           @unique
  delivery                MedicineDelivery? @relation(fields: [deliveryId], references: [id], onDelete: SetNull)
  amountTzs               Int // whole TZS — see CLAUDE.md money rules
  // calculateFees snapshot, frozen at creation so later rate changes never
  // alter history. Invariant: platformFeeTzs + vatTzs + doctorAmountTzs = amountTzs.
  platformFeeTzs          Int               @default(0) // platform commission EXCLUDING VAT
  vatTzs                  Int               @default(0) // VAT on the commission (never on the medical fee)
  doctorAmountTzs         Int               @default(0)
  commissionBps           Int? // rates used (null on pre-13a rows: legacy 10% split, no VAT)
  vatBps                  Int? // 0 when VAT was disabled
  vatMode                 VatMode?
  feeSettingsId           String?
  feeSettings             FeeSettings?      @relation(fields: [feeSettingsId], references: [id], onDelete: Restrict)
  // AzamPay's own charge on this collection, when known; absorbed by the platform.
  providerFeeTzs          Int?
  providerFeeSource       String? // 'PROVIDER' (API) | 'STATEMENT' (reconciliation import)
  method                  PaymentMethod
  status                  PaymentStatus     @default(PENDING)
  idempotencyKey          String            @unique // `${appointmentId}:${attempt}`
  attempt                 Int               @default(1)
  payerPhone              String? // mobile-money MSISDN, +255XXXXXXXXX
  aggregatorTransactionId String? // provider reference from initiateCollection
  externalReference       String?
  failureReason           String?
  paidAt                  DateTime?
  refundAmountTzs         Int?
  refundReference         String?
  refundReason            String?
  refundPending           Boolean           @default(false) // provider refund failed — chase manually
  refundedAt              DateTime?
  refundState             RefundState?
  refundAttempts          Int               @default(0) // refund disbursement reference = r<attempt>-<paymentId>
  refundKind              RefundKind? // set when a refund is claimed; null once an EXCESS refund completes
  // Overpayment difference already paid back (EXCESS refund). A later FULL
  // refund returns receivedAmountTzs − excessRefundedTzs.
  excessRefundedTzs       Int               @default(0)
  excessRefundReference   String?
  excessRefundedAt        DateTime?
  // What the provider says it actually collected (callback/status/statement).
  receivedAmountTzs       Int?
  // Admin review queue (late success, amount mismatch, stuck, stray attempt).
  reviewReason            PaymentReviewReason?
  reviewNote              String?
  reviewFlaggedAt         DateTime?
  reviewResolvedAt        DateTime?
  reviewResolvedByUserId  String?
  // The appointment stopped being payable while this payment was in flight:
  // keep checking the provider until final, then late success ⇒ refund.
  abandonedAt             DateTime?
  lastStatusCheckAt       DateTime?
  doctorPayments          DoctorPayment[]
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  @@index([patientId, createdAt])
  @@index([status])
  @@index([aggregatorTransactionId])
  @@index([status, updatedAt])
  @@index([reviewReason, reviewResolvedAt])
  @@index([refundState, updatedAt])
  @@index([refundReference])
}

model DoctorPayment {
  id          String              @id @default(cuid())
  doctorId    String
  doctor      Doctor              @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  amountTzs   Int
  // The patient payment this earning came from (fee / commission / VAT breakdown).
  paymentId   String?
  payment     Payment?            @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  kind        DoctorPaymentKind   @default(EARNING)
  note        String?
  failureReason String?
  // Reserved by a payout run; never claimed twice (guarded updateMany on null).
  payoutItemId String?
  payoutItem   PayoutItem?        @relation(fields: [payoutItemId], references: [id], onDelete: Restrict)
  periodStart DateTime
  periodEnd   DateTime
  status      DoctorPaymentStatus @default(PENDING)
  // consultation:<id> | refund-adjustment:<paymentId> | … — one row per
  // reference, enforced by the database (createIfMissing relies on it).
  reference   String?             @unique
  paidAt      DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([doctorId, periodStart])
  @@index([doctorId, status])
  @@index([payoutItemId])
}

// Where a doctor is paid. One per doctor; any change resets verification
// (AzamPay name lookup → doctor confirms the name, or admin verifies) and is
// audited (PAYOUT_ACCOUNT_CHANGED). Payout items snapshot it at send time.
model DoctorPayoutAccount {
  id               String              @id @default(cuid())
  doctorId         String              @unique
  doctor           Doctor              @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  type             PayoutAccountType
  operator         PayoutOperator? // MOBILE_MONEY
  bankName         String? // BANK
  accountNumber    String // +255XXXXXXXXX for mobile money
  accountName      String? // holder name the doctor typed (bank)
  lookupName       String? // holder name AzamPay returned
  status           PayoutAccountStatus
  verifiedAt       DateTime?
  verifiedByUserId String? // set when an admin verified manually
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
}

model PayoutBatch {
  id               String            @id @default(cuid())
  status           PayoutBatchStatus @default(DRAFT)
  cutoff           DateTime // earnings created before this are included
  totalTzs         Int               @default(0)
  itemCount        Int               @default(0)
  note             String?
  createdByUserId  String
  approvedByUserId String?
  approvedAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  items            PayoutItem[]

  @@index([status, createdAt])
}

model PayoutItem {
  id                String           @id @default(cuid())
  batchId           String
  batch             PayoutBatch      @relation(fields: [batchId], references: [id], onDelete: Restrict)
  doctorId          String
  doctor            Doctor           @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  amountTzs         Int // net of the reserved earnings (adjustments included), > 0
  status            PayoutItemStatus @default(PENDING)
  attempt           Int              @default(0)
  reference         String?          @unique // our disbursement reference p<attempt>-<itemId>
  providerReference String? // AzamPay pgReferenceId
  providerFeeTzs    Int?
  failureReason     String?
  method            String? // 'AZAMPAY' | 'MANUAL'
  manualReference   String?
  accountSnapshot   Json? // type / operator / bank / number / name at send time
  paidAt            DateTime?
  lastStatusCheckAt DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  earnings          DoctorPayment[]

  @@unique([batchId, doctorId])
  @@index([status, updatedAt])
  @@index([providerReference])
}

// Platform fee settings, EFFECTIVE-DATED and insert-only: the row in force at
// time T is the latest with effectiveFrom <= T. Changing a rate adds a row
// (audited FEE_SETTINGS_CHANGED); history is never edited, and every Payment
// snapshots the rates it used.
model FeeSettings {
  id              String    @id @default(cuid())
  commissionBps   Int // 2000 = 20%
  vatEnabled      Boolean
  vatBps          Int // 1800 = 18%
  vatMode         VatMode
  minPayoutTzs    Int // doctor payouts below this carry forward
  effectiveFrom   DateTime
  createdByUserId String?
  note            String?
  createdAt       DateTime  @default(now())
  payments        Payment[]

  @@index([effectiveFrom])
}

// ─── Notifications & audit ───────────────────────────────────────────────────

model Notification {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   NotificationChannel
  status    NotificationStatus  @default(PENDING)
  language  Language            @default(SW)
  title     String
  body      String
  metadata  Json?
  sentAt    DateTime?
  readAt    DateTime?
  createdAt DateTime            @default(now())

  @@index([userId, createdAt])
  @@index([status])
}

// Append-only. Every PHI access must be recorded here (PDPA 2022).
model AuditLog {
  id           String   @id @default(cuid())
  actorUserId  String?
  actor        User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  action       String // e.g. MEDICAL_RECORD_VIEWED, PRESCRIPTION_CREATED
  resourceType String // model name
  resourceId   String?
  ipAddress    String?
  userAgent    String?
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([resourceType, resourceId])
  @@index([actorUserId, createdAt])
}
