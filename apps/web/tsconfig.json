{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    // React 19 dropped the global JSX namespace; without this TS falls back to
    // the one styled-jsx declares (React 18 era) and every component "is not a
    // valid JSX element type".
    "jsxImportSource": "react",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    // See apps/mobile/tsconfig.json: the monorepo runs React 18 (mobile) and
    // React 19 (here) side by side, and pnpm has only one hoisted @types/react
    // for packages that do not declare it. Pinning `react` to this app's own
    // React 19 typings keeps library .d.ts files (react-query, next) on the
    // same major as the app itself.
    "paths": {
      "@/*": ["./src/*"],
      "react": ["./node_modules/@types/react"],
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime"],
      "react-dom": ["./node_modules/@types/react-dom"]
    },
    "types": ["node", "vitest/globals", "@testing-library/jest-dom"]
  },
  "include": ["next-env.d.ts", "src", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".next"]
}
