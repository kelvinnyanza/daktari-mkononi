{
  "name": "daktari-mkononi",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:integration": "node scripts/test-integration.mjs",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:setup": "node scripts/dev-setup.mjs",
    "dev:doctor": "node scripts/dev-doctor.mjs",
    "db:install": "node scripts/db.mjs install",
    "db:start": "node scripts/db.mjs start",
    "db:stop": "node scripts/db.mjs stop",
    "db:status": "node scripts/db.mjs status",
    "db:reset": "node scripts/db.mjs reset",
    "db:push": "pnpm --filter @daktari/db db:push",
    "db:seed": "pnpm --filter @daktari/db db:seed"
  },
  "devDependencies": {
    "@daktari/config": "workspace:*",
    "@eslint/js": "^9.30.0",
    "eslint": "^9.30.0",
    "prettier": "^3.5.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.35.0"
  }
}
